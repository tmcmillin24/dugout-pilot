{
  "expo": {
    "name": "Dugout Pilot",
    "slug": "dugout-pilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dugout-app-icon.png",
    "scheme": "dugoutpilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/dugout-app-icon.png",
      "bundleIdentifier": "com.dugoutpilot.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/dugout-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/images/dugout-app-icon.png"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/dugout-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/dugout-launch.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/dugout-app-icon.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your team logo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
